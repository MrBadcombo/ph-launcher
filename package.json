{
  "name": "ph-launcher",
  "version": "2.0.0",
  "description": "PH لانچر - یک لانچر آفلاین برای ماینکرافت با سیستم رنک و XP",
  "main": "main.js",
  "author": "PH Launcher",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build-win": "electron-builder --win",
    "build-linux": "electron-builder --linux",
    "build-mac": "electron-builder --mac"
  },
  "dependencies": {
    "adm-zip": "^0.5.10",
    "tar": "^6.2.0",
    "discord-rpc": "^4.0.1"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.phlauncher.app",
    "productName": "PH Launcher",
    "icon": "assets/icon.png",
    "files": [
      "**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.png"
    }
  }
}
